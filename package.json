{
  "name": "ai-host-optimizer",
  "version": "0.0.1",
  "description": "Profile a host and recommend AI-model optimizations. Read-only by default; applies only user-selected, reversible changes with explicit consent.",
  "type": "module",
  "license": "MIT",
  "author": "William (Liam) Doring",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ai-host-optimizer": "dist/index.js",
    "aiho": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"dist/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "optimization",
    "ollama",
    "llama.cpp",
    "vllm",
    "performance",
    "sysadmin",
    "gpu",
    "kv-cache"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamdoring-prog/ai-host-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/williamdoring-prog/ai-host-optimizer/issues"
  },
  "homepage": "https://github.com/williamdoring-prog/ai-host-optimizer#readme"
}
